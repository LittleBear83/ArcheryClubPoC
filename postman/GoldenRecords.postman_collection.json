            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('JSON array response', function () {",
                  "  pm.expect(pm.response.json()).to.be.an('array');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "{{grAuthorization}}"
              },
              {
                "key": "User-Agent",
                "value": "{{effectiveUserAgent}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/members?pageNumber=1&pageSize=1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "members"
