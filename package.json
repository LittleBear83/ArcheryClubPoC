{
  "name": "archeryclubpoc",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "node --watch-path=server/index.js --watch-path=server/bootstrap --watch-path=server/config --watch-path=server/domain --watch-path=server/infrastructure --watch-path=server/observability --watch-path=server/presentation --watch-path=server/security --watch-path=shared server/index.js",
    "dev:full": "node scripts/dev-full.mjs",
    "build": "vite build",
    "lint": "eslint .",
    "migrate:postgres": "node scripts/migrateSqliteToPostgres.mjs",
    "sync:hash-secret": "node scripts/hashMachineSecret.mjs",
    "sync:local": "node scripts/syncLocalDatabase.mjs",
    "sync:local:initial": "node scripts/syncLocalDatabase.mjs --initial",
    "sync:status": "node scripts/showLocalSyncStatus.mjs",
    "seed:live-showcase": "node scripts/seedLiveShowcase.mjs",
    "seed:runtime-showcase": "node scripts/seedRuntimeShowcase.mjs",
    "test": "node scripts/run-tests.mjs",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview --host 0.0.0.0 --port 8080",
    "start": "node server/index.js"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@g-loot/react-tournament-brackets": "^1.0.31-rc",
    "@mui/material": "^9.3.1",
    "@nivo/sankey": "^0.99.0",
    "@tanstack/react-query": "^5.97.0",
    "better-sqlite3": "^12.8.0",
    "concurrently": "^9.2.1",
    "express": "^5.2.1",
    "helmet": "^8.1.0",
    "pg": "^8.20.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^6.30.3",
    "react-svg-pan-zoom": "^3.13.1",
    "styled-components": "^6.5.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.58.1",
    "@typescript-eslint/parser": "^8.58.1",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.1"
  }
