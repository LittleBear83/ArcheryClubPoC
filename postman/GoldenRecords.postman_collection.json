{
  "info": {
    "_postman_id": "8b89f56d-f2d5-4ac2-afde-faa9984651f5",
    "name": "Golden Records API",
    "description": "Postman collection for the Golden Records endpoints used and planned by ArcheryClubPoC.\n\nAuth modes supported:\n- api-key: sends `Authorization: Basic {{apiKey}}`\n- member-credentials: sends `Authorization: Basic <base64(username:password)>`\n\nThis matches the behavior implemented in `server/infrastructure/golden-records/goldenRecordsAuth.js` and `server/infrastructure/golden-records/goldenRecordsHttpClient.js`.\n\nPlanned endpoints are included for discovery and manual testing, based on `docs/GoldenRecordsIntegrationTodo.md`.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const authMode = (pm.variables.get('authMode') || 'api-key').trim().toLowerCase();",
          "const apiKey = (pm.variables.get('apiKey') || '').trim();",
          "const username = (pm.variables.get('username') || '').trim();",
          "const password = pm.variables.get('password') || '';",
          "",
          "if (authMode === 'member-credentials') {",
          "  if (!username || !password) {",
          "    throw new Error('member-credentials authMode requires username and password variables.');",
          "  }",
          "",
          "  const encoded = CryptoJS.enc.Base64.stringify(CryptoJS.enc.Utf8.parse(`${username}:${password}`));",
          "  pm.variables.set('grAuthorization', `Basic ${encoded}`);",
          "} else {",
          "  if (!apiKey) {",
          "    throw new Error('api-key authMode requires an apiKey variable.');",
          "  }",
          "",
          "  pm.variables.set('grAuthorization', `Basic ${apiKey}`);",
          "}",
          "",
          "pm.variables.set('effectiveUserAgent', (pm.variables.get('userAgent') || 'ArcheryClubPoC/1.0').trim() || 'ArcheryClubPoC/1.0');"
        ]
      }
    }
  ],
